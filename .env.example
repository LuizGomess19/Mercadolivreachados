# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# Supabase > Project Settings > API (ou "API Keys")

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (service_role / sb_secret_...). Nunca use NEXT_PUBLIC_ nela!
SUPABASE_SERVICE_ROLE_KEY=

# PIN do painel do proprietário (já configurado na Vercel)
# ADMIN_PIN=
